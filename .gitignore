# ── Package/Dependency Directories ─────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build/Distribution Outputs ────────────────────────────
dist/
backend/dist/
frontend/.next/
frontend/out/
frontend/build/
*.tsbuildinfo
frontend/next-env.d.ts

# ── Environment & Configuration Secret Files ──────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# ── Sensitive rclone Config & Credentials ──────────────────
# MUST NOT BE COMMITTED TO GITHUB!
rclone-config/rclone.conf
rclone-config/service-account.json
# Allow other config-related files like gitkeep to stay
!rclone-config/.gitkeep

# ── Scratch/Temporary Testing Scripts ──────────────────────
# Scratch files might contain active OAuth tokens or keys
scratch*.ts
backend/scratch*.ts
scratch/
backend/scratch/

# ── Logs & Reports ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/
/backend/logs/

# ── Miscellaneous ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
*.key
