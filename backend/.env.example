# ── Application ────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ───────────────────────────────────
DATABASE_URL=postgresql://ddp_user:ddp_secret_2024@localhost:5432/data_delivery_platform?schema=public

# ── Redis ──────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# ── rclone RC ──────────────────────────────────
RCLONE_RC_URL=http://localhost:5572

# ── AWS Credentials ────────────────────────────
# Set these if running locally and assuming roles using an IAM User access key.
# Leave blank when running on EC2 to automatically use Instance Profile roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_OPERATIONAL_ROLE_ARN=arn:aws:iam::123456789012:role/rclone-transfer-role

# ── Google Drive ───────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json
# Set this to a user's email inside your Google Workspace domain if you wish to impersonate them (requires Domain-Wide Delegation).
# This is required if you want to write to personal "My Drive" folders without hitting the Service Account storage quota error.
# GOOGLE_IMPERSONATE_USER=user@yourdomain.com

# ── Notifications ──────────────────────────────
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourcompany.com

# Slack
SLACK_WEBHOOK_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Admin Seed ─────────────────────────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
