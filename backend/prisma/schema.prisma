// ─── Prisma Schema for Data Delivery Platform ───────────────────────────────
// Google Drive → Customer AWS S3 via AssumeRole + rclone

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users & Auth ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(OPERATOR)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transfers Transfer[]
  auditLogs AuditLog[]

  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
}

// ── Customer Configuration ────────────────────────────────────────────────────

model Customer {
  id            String    @id @default(uuid())
  name          String
  roleArn       String    @map("role_arn")
  bucketName    String    @map("bucket_name")
  region        String    @default("ap-south-1")
  prefixPath    String    @default("") @map("prefix_path")
  externalId    String?   @map("external_id")
  isValidated   Boolean   @default(false) @map("is_validated")
  lastValidated DateTime? @map("last_validated")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  transfers Transfer[]
  validations Validation[]

  @@map("customers")
}

// ── Google Drive Source ────────────────────────────────────────────────────────

model GoogleDriveSource {
  id            String         @id @default(uuid())
  name          String
  drivePath     String         @map("drive_path")
  driveType     DriveType      @default(MY_DRIVE) @map("drive_type")
  sharedDriveId String?        @map("shared_drive_id")
  authType      GdriveAuthType @default(SERVICE_ACCOUNT) @map("auth_type")
  clientId      String?        @map("client_id")
  clientSecret  String?        @map("client_secret")
  tokenJson     String?        @map("token_json")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  transfers Transfer[]
  validations Validation[]

  @@map("google_drive_sources")
}

enum GdriveAuthType {
  SERVICE_ACCOUNT
  OAUTH
}

enum DriveType {
  MY_DRIVE
  SHARED_DRIVE
}

// ── Transfer Jobs ─────────────────────────────────────────────────────────────

model Transfer {
  id        String         @id @default(uuid())
  name      String
  direction TransferDirection @default(PUSH)
  status    TransferStatus @default(QUEUED)
  mode      TransferMode   @default(COPY)

  // Source
  sourceId   String?            @map("source_id")
  source     GoogleDriveSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceName String?            @map("source_name")
  sourcePath String?            @map("source_path")

  // Destination
  customerId      String?   @map("customer_id")
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName    String?   @map("customer_name")
  customerBucket  String?   @map("customer_bucket")
  destinationPath String    @map("destination_path")

  // Performance Settings
  concurrency    Int     @default(6)
  checkers       Int     @default(32)
  retries        Int     @default(50)
  bandwidthLimit String? @map("bandwidth_limit")
  skipDeletion   Boolean @default(false) @map("skip_deletion")
  dryRunReport   Json?   @map("dry_run_report")

  // Progress Tracking
  totalBytes       BigInt @default(0) @map("total_bytes")
  transferredBytes BigInt @default(0) @map("transferred_bytes")
  totalFiles       Int    @default(0) @map("total_files")
  transferredFiles Int    @default(0) @map("transferred_files")
  failedFiles      Int    @default(0) @map("failed_files")
  currentSpeed     String? @map("current_speed")
  eta              String?
  errorCount       Int    @default(0) @map("error_count")

  // rclone Tracking
  rcloneJobId Int?    @map("rclone_job_id")
  rcloneGroup String? @map("rclone_group")

  // Scheduling
  scheduledAt    DateTime?     @map("scheduled_at")
  scheduleType   ScheduleType? @map("schedule_type")
  cronExpression String?       @map("cron_expression")

  // Timestamps
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  createdById String @map("created_by_id")
  createdBy   User   @relation(fields: [createdById], references: [id])

  logs      TransferLog[]
  snapshots ProgressSnapshot[]

  @@index([status])
  @@index([createdAt])
  @@map("transfers")
}

enum TransferDirection {
  PUSH
  PULL
}

enum TransferStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  RETRYING
  SCHEDULED
}

enum TransferMode {
  COPY
  SYNC
  MOVE
}

enum ScheduleType {
  ONE_TIME
  DAILY
  WEEKLY
}

// ── Progress Snapshots (time-series for charts) ───────────────────────────────

model ProgressSnapshot {
  id               String   @id @default(uuid())
  transferId       String   @map("transfer_id")
  transfer         Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  bytesTransferred BigInt   @map("bytes_transferred")
  filesTransferred Int      @map("files_transferred")
  speed            String
  eta              String?
  errorCount       Int      @default(0) @map("error_count")
  timestamp        DateTime @default(now())

  @@index([transferId, timestamp])
  @@map("progress_snapshots")
}

// ── Transfer Logs ─────────────────────────────────────────────────────────────

model TransferLog {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  level      LogLevel
  message    String
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([transferId, timestamp])
  @@index([level])
  @@map("transfer_logs")
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

// ── Audit Logs ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action])
  @@map("audit_logs")
}

// ── Notification Settings ─────────────────────────────────────────────────────

model NotificationSetting {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  config    Json
  isActive  Boolean             @default(true) @map("is_active")
  events    String[]
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("notification_settings")
}

enum NotificationChannel {
  EMAIL
  SLACK
  TELEGRAM
}

// ── Folder Validations ────────────────────────────────────────────────────────

model Validation {
  id              String           @id @default(uuid())
  name            String
  status          ValidationStatus @default(PENDING)
  oneWay          Boolean          @default(false) @map("one_way")

  // Source (Google Drive)
  sourceId        String            @map("source_id")
  source          GoogleDriveSource @relation(fields: [sourceId], references: [id])
  sourcePath      String            @map("source_path")

  // Destination (S3 Customer)
  customerId      String            @map("customer_id")
  customer        Customer          @relation(fields: [customerId], references: [id])
  destinationPath String            @map("destination_path")

  // Sizing summaries
  srcTotalBytes   BigInt            @default(0) @map("src_total_bytes")
  srcTotalFiles   Int               @default(0) @map("src_total_files")
  dstTotalBytes   BigInt            @default(0) @map("dst_total_bytes")
  dstTotalFiles   Int               @default(0) @map("dst_total_files")

  // Comparison counters
  matchCount      Int               @default(0) @map("match_count")
  differCount     Int               @default(0) @map("differ_count")
  missingSrcCount Int               @default(0) @map("missing_src_count")
  missingDstCount Int               @default(0) @map("missing_dst_count")
  errorCount      Int               @default(0) @map("error_count")

  // Output storage
  reportPath      String?           @map("report_path")
  errorMessage    String?           @map("error_message")

  // Timestamps
  startedAt       DateTime?         @map("started_at")
  completedAt     DateTime?         @map("completed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@map("validations")
}

enum ValidationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// ── Audio Duration Analyzer History ──────────────────────────────────────────

model WavCalculation {
  id              String   @id @default(uuid())
  name            String
  storageType     String   @map("storage_type") // "S3" or "GDrive"
  targetPath      String   @map("target_path")
  sourceName      String   @map("source_name")  // Customer name or GDrive source name
  status          String   @default("PENDING")
  progressScanned Int      @default(0) @map("progress_scanned")
  progressTotal   Int      @default(0) @map("progress_total")
  currentFile     String   @default("") @map("current_file")
  errorMessage    String?  @map("error_message")
  totalDuration   Float    @default(0) @map("total_duration")
  wavCount        Int      @default(0) @map("wav_count")
  skippedCount    Int      @default(0) @map("skipped_count")
  files           Json     @default("[]")      // List of WavFileDetails: Array<{ name: string, path: string, size: number, duration: number }>
  parameters      Json?                         // Parameters used to run: { roleArn, bucketName, region, externalId, sharedDriveId, authType }
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("wav_calculations")
}
